{
  "name": "mindforge",
  "version": "1.0.0",
  "description": "MindForge: an AI tutoring platform where every session becomes long-term memory. Streaming LLM tutors with teaching styles and voice, cited RAG over your own notes, FSRS-4.5 spaced repetition and a gamified progress engine.",
  "private": true,
  "type": "module",
  "author": "Kunal Shaw",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "db:push": "npx prisma db push",
    "db:generate": "npx prisma generate",
    "db:studio": "npx prisma studio",
    "postinstall": "prisma generate",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.7",
    "@prisma/client": "^5.20.0",
    "@upstash/ratelimit": "^2.0.4",
    "@upstash/redis": "^1.34.3",
    "lucide-react": "^0.539.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^9.0.1",
    "recharts": "^2.14.1",
    "remark-gfm": "^4.0.0",
    "sonner": "^1.7.1",
    "unpdf": "^1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.4.1",
    "prisma": "^5.20.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
