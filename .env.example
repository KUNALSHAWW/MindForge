# --- Required -------------------------------------------------------------

# Clerk authentication (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Recommended (the app runs in demo mode without these) ----------------

# PostgreSQL (Supabase, Neon, local Docker...). Then run: npm run db:push
DATABASE_URL="postgresql://user:password@localhost:5432/mindforge"

# Tutor LLM: any OpenAI-compatible chat completions API.
# Defaults to Hugging Face Inference Providers using HUGGINGFACE_API_KEY.
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=llama3.1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Hugging Face token with "Inference Providers" permission.
# Used for the default LLM and for semantic embeddings (BAAI/bge-small-en-v1.5).
HUGGINGFACE_API_KEY=
EMBEDDING_MODEL=

# --- Optional ---------------------------------------------------------------

# Upstash Redis for rate limiting across serverless instances (in-memory otherwise)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000
